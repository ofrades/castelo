# Copy to .kamal/secrets before running kamal deploy
# cp .kamal/secrets.example .kamal/secrets

KAMAL_REGISTRY_USERNAME=your-github-username
KAMAL_REGISTRY_PASSWORD=your-github-token-with-read:packages,write:packages

AUTH_SECRET=change-me-to-a-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OPENROUTER_API_KEY=your-openrouter-api-key
STRIPE_SECRET_KEY=sk_live_or_test
STRIPE_WEBHOOK_SECRET=whsec_for_castelo_endpoint

# Optional R2 backup for uploaded originals. Leave blank if local disk only is OK.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
